"""
The checks of this workspace the generic `rust` module cannot express: the
workspace tests with every feature, and the end-to-end suites against a real
Restate server (the handler layer of `restate-szamlazz`); and the `restate-server` binary
those suites run against, exported for a developer
(`dagger call ci restate-server export --path ./restate-server`).

Runs on the `rust` module's container (wired in as `container` from
`rust:container`): the toolchain, the workspace at `/work/src` and the cargo
caches. The two checks share one compilation of the test targets.
"""
type Ci {
  let container: Container!
  let restateVersion: String!

  new(
    """
    The Rust toolchain container with the workspace mounted (`rust:container`).
    """
    container: Container!,
    """
    The Restate server version the end-to-end suite runs against; the image
    `docker.restate.dev/restatedev/restate:<version>` provides the binary.
    """
    restateVersion: String! = "1.7.8",
  ) {
    self.container = container
    self.restateVersion = restateVersion

    self
  }

  """
  `cargo test` with every feature of every crate. Plain `cargo test` compiles
  the `szamlazz-adatkapcsolat` archiver tests (behind `opendal`) and the
  `schemars` contract tests of `restate-szamlazz` to nothing; this runs them.
  Doctests included (`--all-targets` would drop them).
  """
  test: String! @check {
    self
      .compiled
      .withExec(["cargo", "test", "--workspace", "--all-features", "--locked"])
      .combinedOutput
  }

  """
  End to end: the ignored `e2e_` tests of the workspace against
  `restate-server` processes the harness spawns in this container from the
  binary of the Restate image (`RESTATE_SERVER_BIN`; there is no docker here).
  The `tests/e2e` suite of `restate-szamlazz` (the `Szamlazz.Order` and
  `Szamlazz.Agent` handlers, the multi-account flag day and scope isolation,
  the journal scan for the agent key, the step-name table check and the protocol-v7
  canary), using the published `restate-e2e-harness` crate.
  `CI` is set, so a run without a server fails instead of
  skipping.

  Runs with the selection `compiled` built (`--workspace --all-features`, every
  test target), narrowed to the ignored e2e tests by name, so workspace targets
  need no compilation here.
  Selecting a package (`-p restate-szamlazz`) or a target
  (`--test e2e`) unifies dev-dependency features differently (only the
  packages with a selected dev target contribute theirs) and recompiles
  fifty-odd crates, `tokio`, `hyper`, `reqwest` and `restate-sdk` among them,
  before the suite starts: a minute of every run. The other test binaries
  start, match nothing and exit. When the suite fails, the log of every
  `restate-server` the harness kept (a failing test keeps the server's base
  dir) follows the output, since the container is discarded with the check.
  """
  endToEnd: String! @check {
    self
      .compiled
      .withFile("/usr/local/bin/restate-server", self.restateServer)
      .withEnvVariable("RESTATE_SERVER_BIN", "/usr/local/bin/restate-server")
      .withEnvVariable("CI", "true")
      .withExec(["sh", "-c", self.endToEndScript])
      .combinedOutput
  }

  """
  The e2e run, then its kept server logs when it failed, exiting with the
  run's status.
  """
  let endToEndScript: String! = """cargo test --workspace --all-features --locked --tests -- --ignored e2e_
status=$?
if [ "$status" -ne 0 ]; then
  for log in "${TMPDIR:-/tmp}"/restate-e2e-*/restate-server.log; do
    [ -f "$log" ] || continue
    echo
    echo "==== $log (kept by the harness; last 300 lines) ===="
    tail -n 300 "$log"
  done
fi
exit "$status"
"""

  """
  The container with every test target compiled once, for both checks: the
  same selection both run with.
  """
  let compiled: Container! {
    self
      .container
      .withExec(["cargo", "test", "--workspace", "--all-features", "--locked", "--no-run"])
  }

  """
  The `restate-server` binary, taken from the Restate image: what the
  end-to-end check runs against, and what a developer exports to run the
  suites locally (`dagger call ci restate-server export --path
  ./restate-server`, then `RESTATE_SERVER_BIN=$PWD/restate-server`).
  """
  restateServer: File! {
    Dagger
      .container
      .from("docker.restate.dev/restatedev/restate:" + self.restateVersion)
      .file("/usr/local/bin/restate-server")
  }
}
